# PostgreSQL Database - CHANGE THESE IN PRODUCTION!
DATABASE_URL=postgresql://user:password@localhost:5432/zentral_hack
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=zentral_hack
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Database Connection Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=20

# JWT Configuration - GENERATE A NEW SECRET!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_A_SECURE_SECRET_IN_PRODUCTION
JWT_EXPIRATION=24h

# Email Configuration (Gmail, SendGrid, etc)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=your_email@example.com
SMTP_FROM_NAME=your_name

RESEND_API_KEY=YOUR_RESEND_API_KEY

# Newsletter (Resend Broadcasts)
# Sender address used for every newsletter broadcast.
RESEND_NEWSLETTER_FROM=<from> <noreply@example.com>
# Resend segment id used for the "all contacts" target and as the placeholder
# segment a new draft broadcast requires. Falls back to the first segment when unset.
RESEND_NEWSLETTER_DEFAULT_SEGMENT_ID=YOUR_RESEND_SEGMENT_ID

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2FA Configuration
TWO_FA_EXPIRATION=15m

# Storage
BLOB_READ_WRITE_TOKEN=VERCEL_BLOB_READ_WRITE_TOKEN
UPSTASH_KV_REST_API_TOKEN=VERCEL_UPSTASH_KV_REST_API_TOKEN
UPSTASH_KV_REST_API_URL=VERCEL_UPSTASH_KV_REST_API_URL

# release.mjs
RELEASE_TOKEN=STAIR_GITHUB_PAT
VERCEL_TOKEN=STAIR_VERCEL_TOKEN
VERCEL_PROD_PROJECT_ID=ZENTRALHACK_PROD_VERCEL_PROJECT_ID

# --- DEVELOPMENT ONLY ---
TEST_EMAIL=YOUR_PRIVATE_EMAIL
# To skip 2FA if NODE_ENV != production.
BYPASS_2FA=false
