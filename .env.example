# PostgreSQL Database - CHANGE THESE IN PRODUCTION!
DATABASE_URL=postgresql://user:password@localhost:5432/zentral_hack
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=zentral_hack
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Database Connection Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=20

# JWT Configuration - GENERATE A NEW SECRET!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_A_SECURE_SECRET_IN_PRODUCTION
JWT_EXPIRATION=24h

# Email Configuration (Gmail, SendGrid, etc)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@zentral-hack.ch
SMTP_FROM_NAME=Zentral Hack

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2FA Configuration
TWO_FA_EXPIRATION=15m

# release.mjs
RELEASE_TOKEN=STAIR_GITHUB_PAT
VERCEL_TOKEN=STAIR_VERCEL_TOKEN
VERCEL_PROD_PROJECT_ID=ZENTRALHACK_PROD_VERCEL_PROJECT_ID

# --- DEVELOPMENT ONLY ---
TEST_EMAIL=YOUR_PRIVATE_EMAIL
